# توکن ربات از @BotFather
BOT_TOKEN=123456:ABC-your-bot-token

# آیدی عددی تو (یا چند نفر با کاما جدا شده) که مالک/سوپرادمین ربات محسوب می‌شن
# آیدی عددیت رو می‌تونی از @userinfobot بگیری
OWNER_IDS=123456789

# آدرس دیتابیس. پیش‌فرض یک فایل SQLite کنار پروژه‌ست.
# روی Railway پیشنهاد می‌شه یا Volume وصل کنی (پایین توضیح داده شده) یا از Postgres استفاده کنی.
DATABASE_URL=sqlite+aiosqlite:///groupguard.db

# پنل Mini App (پیش‌فرض فعاله)
MINIAPP_ENABLED=true
MINIAPP_HOST=0.0.0.0
# روی Railway نیازی به ست کردن MINIAPP_PORT نیست؛ خودش با متغیر PORT ست می‌شه.
MINIAPP_PORT=8080

# آدرس عمومی HTTPS جایی که همین سرویس ازش در دسترسه (بعد از فعال‌سازی Generate Domain در Railway پرش کن)
# مثال: https://your-app.up.railway.app
MINIAPP_PUBLIC_URL=
